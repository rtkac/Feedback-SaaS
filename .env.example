# ── Auth ────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000      # public base URL of the auth-web app
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001  # comma-separated allowed origins (admin-web, etc.)

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=                              # postgres connection string

# ── App URLs (exposed to the browser via VITE_ prefix) ──────────────────────
VITE_FEEDBACK_SAAS_ADMIN_WEB_URL=http://localhost:3001
VITE_FEEDBACK_SAAS_AUTH_WEB_URL=http://localhost:3000

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_ADDRESS=                             # sender address (e.g. Gmail)
EMAIL_PASSWORD=                            # app password — never commit the real value
