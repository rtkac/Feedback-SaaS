{
  "name": "@feedback-saas",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "clean": "bunx --bun rimraf '*/*/build' '*/*/dist' '*/*/node_modules' .turbo '*/*/.turbo' bun.lock node_modules --glob",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint",
    "format": "oxfmt --check",
    "format:write": "oxfmt",
    "test": "turbo run test",
    "seed": "bun run scripts/seed.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/bun": "1.3.14",
    "lefthook": "2.1.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "turbo": "2.10.7"
  },
  "engines": {
    "bun": "^1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@sentry/tanstackstart-react": "10.69.0"
  }
}
