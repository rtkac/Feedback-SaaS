{
  "name": "@feedback-saas/db",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema/*": {
      "types": "./src/schema/*.ts",
      "default": "./dist/schema/*.js"
    },
    "./queries/*": {
      "types": "./src/queries/*.ts",
      "default": "./dist/queries/*.js"
    }
  },
  "scripts": {
    "watch": "tsc --watch",
    "build": "tsc",
    "better-auth:generate": "bunx auth@latest generate --config=../auth/src/index.ts --output=./src/schema",
    "db:push": "bunx drizzle-kit push",
    "db:generate": "bunx drizzle-kit generate",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "better-auth": "1.7.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
