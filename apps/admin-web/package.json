{
  "name": "admin-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--import ./instrument.server.mjs' bun --env-file=../../.env run vite dev --port 3001 && bun run watch-routes",
    "build": "bun run generate-routes && bun --env-file=../../.env run vite build && cp instrument.server.mjs dist/server",
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@feedback-saas/auth": "workspace:*",
    "@feedback-saas/db": "workspace:*",
    "@feedback-saas/ui": "workspace:*",
    "@feedback-saas/utils": "workspace:*",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@sentry/tanstackstart-react": "catalog:",
    "@tabler/icons-react": "3.46.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-form": "1.33.2",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.33",
    "@tanstack/router-plugin": "1.168.23",
    "better-auth": "1.6.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.16.0",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.22.0",
    "@tanstack/devtools-vite": "0.8.1",
    "@tanstack/router-cli": "1.167.21",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
