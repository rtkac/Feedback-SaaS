{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "with": ["@feedback-saas/ui#watch"],
      "cache": false,
      "persistent": true
    },
    "//#lint": {
      "dependsOn": ["^build"]
    },
    "//#format": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "watch": { "cache": false, "persistent": true }
  }
}
