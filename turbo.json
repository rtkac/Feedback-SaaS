{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "DATABASE_URL",
    "EMAIL_ADDRESS",
    "EMAIL_PASSWORD",
    "VITE_FEEDBACK_SAAS_AUTH_WEB_URL",
    "VITE_FEEDBACK_SAAS_ADMIN_WEB_URL",
    "VITE_APP_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "with": ["@feedback-saas/ui#watch", "@feedback-saas/db#watch"],
      "cache": false,
      "persistent": true
    },
    "//#lint": {
      "dependsOn": ["^build"]
    },
    "//#format": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "watch": { "cache": false, "persistent": true }
  }
}
